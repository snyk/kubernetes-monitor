{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": [],
  "properties": {
    "clusterName": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_:() \\.\\-]{0,62}$"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
